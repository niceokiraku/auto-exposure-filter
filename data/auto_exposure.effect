uniform float4x4 ViewProj;
uniform texture2d image;
uniform float gain;
uniform bool comparison_mode;
uniform float split_pos;
uniform bool show_indicator;
uniform float indicator_value;

sampler_state def_sampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

float4 PSAutoExposure(VertData v_in) : TARGET
{
	float4 color = image.Sample(def_sampler, v_in.uv);

	/* When brightening, taper the gain off for already-bright pixels so
	 * shadows are lifted while highlights stay close to the original.
	 * The taper is 1 for black and falls toward 0 for white. */
	float pixel_gain = gain;
	if (gain > 1.0) {
		float luma = dot(color.rgb, float3(0.2126, 0.7152, 0.0722));
		float taper = pow(saturate(1.0 - luma), 3.0);
		pixel_gain = 1.0 + (gain - 1.0) * taper;
	}
	float3 graded = color.rgb * pixel_gain;

	/* Soft-knee compression above white (1.0) so lifting shadows in a
	 * dark scene doesn't clip highlights that were already bright. */
	float3 outc = graded / (1.0 + max(graded - 1.0, 0.0));
	outc = saturate(outc);

	float4 result = float4(outc, color.a);

	if (comparison_mode) {
		/* Thin bright divider line so the split is easy to spot. */
		float line_half_width = 0.0015;
		if (abs(v_in.uv.x - split_pos) < line_half_width)
			result = float4(1.0, 1.0, 1.0, color.a);
		else if (v_in.uv.x < split_pos)
			result = color;
	}

	if (show_indicator) {
		/* Small gauge in the bottom-left corner: gray track, green fill
		 * sized by indicator_value (0 = no correction happening right
		 * now, 1 = full correction). Drawn last so it stays on top. */
		float bar_x0 = 0.02, bar_x1 = 0.22;
		float bar_y0 = 0.94, bar_y1 = 0.97;
		if (v_in.uv.x >= bar_x0 && v_in.uv.x <= bar_x1 && v_in.uv.y >= bar_y0 && v_in.uv.y <= bar_y1) {
			float fill_x = bar_x0 + (bar_x1 - bar_x0) * saturate(indicator_value);
			if (v_in.uv.x <= fill_x)
				result = float4(0.2, 0.9, 0.3, 1.0);
			else
				result = float4(0.15, 0.15, 0.15, 0.8);
		}
	}

	return result;
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSAutoExposure(v_in);
	}
}
