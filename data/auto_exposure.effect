uniform float4x4 ViewProj;
uniform texture2d image;
uniform float gain;
uniform bool comparison_mode;
uniform float split_pos;
uniform bool show_indicator;
uniform float indicator_value;

sampler_state def_sampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

float4 PSAutoExposure(VertData v_in) : TARGET
{
	/* The input is premultiplied; grade the straight color and
	 * premultiply again on the way out. */
	float4 color = image.Sample(def_sampler, v_in.uv);
	float3 rgb = color.rgb * ((color.a > 0.0) ? (1.0 / color.a) : 0.0);

	float pixel_gain = gain;
	if (gain > 1.0) {
		/* When brightening, taper the gain off for already-bright pixels
		 * so shadows are lifted while highlights stay close to the
		 * original. The taper is 1 for black and falls toward 0 for white. */
		float luma = dot(rgb, float3(0.2126, 0.7152, 0.0722));
		float taper = pow(saturate(1.0 - luma), 3.0);
		pixel_gain = 1.0 + (gain - 1.0) * taper;

		/* Soft knee on the brightest channel: once the boost would push
		 * it past the knee, the excess is compressed so it approaches
		 * but never exceeds 1.0. Saturated colors have a low luma, so
		 * the taper alone would let them clip and wash out. Scaling all
		 * three channels by the same reduced gain keeps the hue. The
		 * knee never sits below the pixel's own level, so pixels that
		 * were already bright are left untouched rather than darkened. */
		float peak = max(rgb.r, max(rgb.g, rgb.b));
		float boosted = peak * pixel_gain;
		float knee = max(peak, 0.8);
		if (boosted > knee) {
			float headroom = 1.0 - knee;
			float compressed = knee;
			if (headroom > 0.0)
				compressed = knee + headroom * (1.0 - exp((knee - boosted) / headroom));
			pixel_gain = compressed / peak;
		}
	}
	float3 outc = saturate(rgb * pixel_gain);

	float4 result = float4(outc * color.a, color.a);

	if (comparison_mode) {
		/* Thin bright divider line so the split is easy to spot. */
		float line_half_width = 0.0015;
		if (abs(v_in.uv.x - split_pos) < line_half_width)
			result = float4(color.a, color.a, color.a, color.a);
		else if (v_in.uv.x < split_pos)
			result = color;
	}

	if (show_indicator) {
		/* Small gauge in the bottom-left corner: gray track, green fill
		 * sized by indicator_value (0 = no correction happening right
		 * now, 1 = full correction). Drawn last so it stays on top. */
		float bar_x0 = 0.02, bar_x1 = 0.22;
		float bar_y0 = 0.94, bar_y1 = 0.97;
		if (v_in.uv.x >= bar_x0 && v_in.uv.x <= bar_x1 && v_in.uv.y >= bar_y0 && v_in.uv.y <= bar_y1) {
			float fill_x = bar_x0 + (bar_x1 - bar_x0) * saturate(indicator_value);
			if (v_in.uv.x <= fill_x)
				result = float4(0.2, 0.9, 0.3, 1.0);
			else
				result = float4(0.12, 0.12, 0.12, 0.8);
		}
	}

	return result;
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSAutoExposure(v_in);
	}
}
